{
  "name": "humanpulse",
  "version": "0.0.0",
  "private": true,
  "description": "观察人类冲突、科技发展与全球社会运动的开源追踪平台",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "pnpm --filter @humanpulse/web run lint",
    "typecheck": "pnpm --filter @humanpulse/api-client run typecheck && pnpm --filter @humanpulse/web run typecheck",
    "test": "pnpm --filter @humanpulse/web run test:run",
    "build": "pnpm --filter @humanpulse/web run build",
    "api-client:generate": "pnpm --filter @humanpulse/api-client run generate",
    "api-client:typecheck": "pnpm --filter @humanpulse/api-client run typecheck",
    "dev:web": "pnpm --filter @humanpulse/web run dev"
  }
}
