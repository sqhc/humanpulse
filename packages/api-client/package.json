{
  "name": "@humanpulse/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "humanpulse REST 契约的共享 TypeScript 客户端（类型由 OpenAPI 生成）",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/openapi.json -o src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
