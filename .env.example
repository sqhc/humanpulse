# ---- 应用 ----
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# 生成: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-before-deploy
CORS_ORIGINS=http://localhost:5173
# 前端调用 API 的基地址（留空表示同源）
VITE_API_BASE_URL=

# ---- 数据库 ----
POSTGRES_USER=humanpulse
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=humanpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://humanpulse:change-me-before-deploy@localhost:5432/humanpulse

# ---- LLM（Phase 1 起使用）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_BULK=deepseek-chat
LLM_MODEL_BRIEF=deepseek-reasoner
LLM_DAILY_TOKEN_BUDGET=2000000

# ---- 流水线（Phase 1 起使用）----
STORE_FULLTEXT=false
SIMHASH_HAMMING_THRESHOLD=3
VECTOR_DUP_THRESHOLD=0.85
VECTOR_DUP_THRESHOLD_HOT=0.80
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- 采集 ----
COLLECTOR_USER_AGENT=humanpulse/0.1 (+https://github.com/sqhc/humanpulse)
HTTP_PROXY=

# ---- 简报 ----
BRIEF_TIMEZONE=UTC
BRIEF_DAILY_CRON=0 6 * * *

# ---- 生产（docker-compose.prod.yml）----
DOMAIN=humanpulse.example.com
TAG=latest
