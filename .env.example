# ---- 应用 ----
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# 生成: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-before-deploy
CORS_ORIGINS=http://localhost:5173
# 前端调用 API 的基地址（留空表示同源）
VITE_API_BASE_URL=

# ---- 数据库 ----
POSTGRES_USER=humanpulse
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_DB=humanpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://humanpulse:change-me-before-deploy@localhost:5432/humanpulse

# ---- LLM（Phase 1 起使用）----
# 真钥匙只填在本机的 .env（.env 已被 gitignore，绝不提交）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名来自 GET https://api.deepseek.com/models 实测：
#   deepseek-flash   = DeepSeek-V4.1-Flash（1M 上下文，表格/图片输入，成本低）→ 批量评分与摘要
#   deepseek-v4-pro  = DeepSeek-V4-Pro（1M 上下文）→ 日报/周报等长文生成
LLM_MODEL_BULK=deepseek-flash
LLM_MODEL_BRIEF=deepseek-v4-pro
LLM_DAILY_TOKEN_BUDGET=2000000

# ---- 单价（每 1M token 美元，低谷价）----
# 来源 https://api-docs.deepseek.com/quick_start/pricing/ （2026-09 抓取）
# deepseek-flash: 命中 0.003 / 未命中 0.15 / 输出 0.60
# deepseek-v4-pro: 命中 0.022 / 未命中 0.66 / 输出 1.98
DEEPSEEK_PRICE_FLASH_CACHE_HIT=0.003
DEEPSEEK_PRICE_FLASH_CACHE_MISS=0.15
DEEPSEEK_PRICE_FLASH_OUTPUT=0.6
DEEPSEEK_PRICE_PRO_CACHE_HIT=0.022
DEEPSEEK_PRICE_PRO_CACHE_MISS=0.66
DEEPSEEK_PRICE_PRO_OUTPUT=1.98
# 高峰时段（周一至周五 01:00-04:00 / 06:00-10:00 UTC）单价翻倍；中国法定节假日未建模
DEEPSEEK_PEAK_MULTIPLIER=2
# deepseek = 真实调用；fake = 确定性假客户端（CI / 离线开发用，不产生费用）
LLM_PROVIDER=deepseek

# ---- 流水线（Phase 1 起使用）----
STORE_FULLTEXT=false
SIMHASH_HAMMING_THRESHOLD=3
VECTOR_DUP_THRESHOLD=0.85
VECTOR_DUP_THRESHOLD_HOT=0.80
# hash = 确定性哈希向量，无需下载模型，但**没有语义能力**：同事件聚类几乎失效（仅开发/CI 用）
# local = sentence-transformers 多语种模型（生产必须）：先 make ml 再切换
# 实测 803 条真实文档：hash 把「霍尔木兹航运」的第 2 条排成「教会虐待丑闻」；
# local 正确聚类出中英混合的同一事件（FBI 涉台谍案 9 篇 / 8 个来源，南非枪击 8 篇）。
# 切换后必须先 make reembed：模型不一致时 /search 会直接返回 409（不返回垃圾结果）。
# 生产镜像要带模型：docker build --build-arg WITH_ML=1 ./backend
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- 视频简报配音（TTS）----
# none = 不做配音（默认，产出无声字幕视频）
# macos-say = 用 macOS 内置 say（本机开发可用；Linux 没有）
# command = 用外部命令模板接 piper / edge-tts / 云 TTS：
#   TTS_COMMAND='piper --model zh_CN.onnx --output_file {out_file} < {text_file}'
# 命令写出的音频不必是目标格式：合成后会自动转成 44.1kHz 单声道
# （piper medium 默认 22.05kHz，直接拼进音轨会整段错速）。
TTS_PROVIDER=none
# macos-say 的语音：Tingting(zh_CN) / Meijia(zh_TW) / Sinji(zh_HK)
TTS_VOICE=Tingting
# piper 需要中文字库（.onnx + .onnx.json），放到镜像里或挂载卷，例如：
#   TTS_PROVIDER=command
#   TTS_COMMAND='piper --model /models/zh_CN-huayan-medium.onnx --output_file {out_file} < {text_file}'
TTS_COMMAND=

# ---- 判官模型（推演用：输出类型化决策与概率，不生成文本）----
# none = 不做推演（默认）；fake = 确定性假实现（CI 用）
# laya = 本地 Laya（make laya-model + make laya-serve，中文用 multilingual checkpoint）
# jev  = 云端 TypeSafe Jev API（同一套请求协议，只差 base_url）
#
# 【推荐配置】判官走云端 Jev（2026-10-15 复测，用户拍板）：
#   实体对齐分类（同一金标准 274 对、只按名称提问）：Jev AUC 1.000 / 锁定测试集 F1 1.000；
#   本地 Laya AUC 0.799 / 校准阈值 0.406 下 F1 0.882（多数类基线 0.781）——
#   两个模型都可用于别名裁决，Jev 明显更强；概率门禁两边都未过
#   （Jev skill -0.36 / ECE 0.19 / AUC 0.53），所以 projection_enabled 必须保持 false，
#   推演一律标注「未经校准」。
#   在 key 有效期内，本机 .env 推荐这样写：
#     JUDGEMENT_PROVIDER=jev
#     JUDGEMENT_BASE_URL=https://api.typesafe.ai
#     JUDGEMENT_MODEL=jev-latest
#     JUDGEMENT_API_KEY=<你的 key>      # 只写在 .env（已 gitignore），不要进仓库
#   注意：key 到期（本批 key 为 2026-10-22）后回退 laya/none。回退到 Laya 后别名裁决
#   仍然可用（AUC 0.799、阈值 0.406），但明显弱于 Jev——建议把批量裁决安排在 key 到期前，
#   不要因为「反正有 Laya」而放松时间安排。
#   下面默认值保持 none：CI 与 make smoke 不继承开发者 .env，不能依赖云端服务。
JUDGEMENT_PROVIDER=none
JUDGEMENT_BASE_URL=http://127.0.0.1:8077
JUDGEMENT_API_KEY=
JUDGEMENT_MODEL=laya-multilingual
JUDGEMENT_TIMEOUT_SECONDS=30
# Laya multilingual 上下文上限 1024 token，state 留余量
JUDGEMENT_MAX_STATE_TOKENS=900

# ---- 推演（链路式后果分析）----
# 关掉时简报与视频维持现状；开启后每期对 Top N 事件生成因果链路
PROJECTION_ENABLED=false
PROJECTION_MAX_EVENTS=3
PROJECTION_HORIZON_DAYS=14
PROJECTION_CHAIN_HOPS=3
# 低于此置信度的节点不进视频断言，只标为「待观察」
PROJECTION_MIN_CONFIDENCE=0.60

# ---- 实体别名裁决（用判官做实体对齐）----
ALIAS_ADJUDICATION_ENABLED=false
# 只有高置信度的候选才自动合并，其余进管理台人工队列
ALIAS_AUTO_MERGE_CONFIDENCE=0.90
ENTITY_WIKIDATA_ENABLED=false

# ---- 采集 ----
COLLECTOR_USER_AGENT=humanpulse/0.1 (+https://github.com/sqhc/humanpulse)
HTTP_PROXY=

# ---- 简报 ----
# 到点之后 worker 每 15 分钟探一次（生成函数幂等，探多次不会重复生成）
BRIEF_HOUR=6
# 周报在每周的哪一天生成：0=周一 … 6=周日
BRIEF_WEEKDAY=6

# ---- 生产（docker-compose.prod.yml）----
DOMAIN=humanpulse.example.com
TAG=latest
